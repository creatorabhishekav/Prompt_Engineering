# Backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Local SQLite (default if unset):
DATABASE_URL=sqlite:///./match_that_image.db
# PostgreSQL / Supabase:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/match_that_image

# --- Authentication ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Supabase (used in later phases for hosted auth/storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Target-image storage ---
# "local" (default) saves uploads under MEDIA_ROOT and serves them at /media.
# "supabase" is a placeholder and will abort until it is implemented.
STORAGE_PROVIDER=local
# MEDIA_ROOT defaults to <backend>/media
# MEDIA_ROOT=./media
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=5

# --- AI provider abstraction ---
# AI_PROVIDER selects the concrete provider (demo today).
# AI_MODE=demo lets the app run without any API key.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODE=demo

# --- Server ---
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Create tables automatically on startup (dev convenience).
AUTO_CREATE_TABLES=true